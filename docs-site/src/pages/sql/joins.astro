import DocsLayout from '../../layouts/DocsLayout.astro'
import PageHeader from '../../components/PageHeader.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import PageLinks from '../../components/PageLinks.astro'
const headings = [
  { depth: 2, slug: 'join-types', text: 'Join types' },
  { depth: 2, slug: 'equality-joins', text: 'Equality joins' },
  { depth: 2, slug: 'general-on', text: 'General ON conditions' },
  { depth: 2, slug: 'execution', text: 'Execution behavior' },
