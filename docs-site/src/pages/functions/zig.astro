---
import DocsLayout from '../../layouts/DocsLayout.astro'
import PageHeader from '../../components/PageHeader.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import Callout from '../../components/Callout.astro'
import PageLinks from '../../components/PageLinks.astro'
const headings = [
  { depth: 2, slug: 'source-function', text: 'Submit Zig source' },
  { depth: 2, slug: 'call-contract', text: 'Call contract' },
  { depth: 2, slug: 'arguments-and-multiple-inputs', text: 'Arguments and multiple inputs' },
  { depth: 2, slug: 'prebuilt-library', text: 'Load a prebuilt library' },
