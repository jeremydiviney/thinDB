import PageLinks from '../../components/PageLinks.astro'
const headings = [
  { depth: 2, slug: 'type-table', text: 'Type table' },
  { depth: 2, slug: 'decimal', text: 'Decimal behavior' },
  { depth: 2, slug: 'temporal', text: 'Temporal behavior' },
